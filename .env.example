# Tiger Cloud (stillbench or your service) — from Tiger Console connection details
DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Free tier: https://twelvedata.com/account/api-keys
TWELVE_DATA_API_KEY=your_api_key_here

# Comma-separated symbols (crypto pairs and/or stock tickers)
SYMBOLS=BTC/USD,ETH/USD,MSFT,AAPL
